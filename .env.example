# Copier ce fichier en .env (local) et configurer les mêmes variables
# dans Netlify (Site settings > Environment variables) pour la prod.
# Aucune de ces valeurs ne doit jamais être exposée côté navigateur :
# elles ne sont lues que par les fonctions serverless (netlify/functions).

# --- Google OAuth 2.0 (identité uniquement : openid + email) ---
# Pas de contournement d'auth en dev : on utilise un vrai client OAuth Google,
# en niveau gratuit (voir cahier des charges §8). Créer un client "Application Web"
# dans Google Cloud Console avec comme URI de redirection autorisée :
#   http://localhost:8888/api/auth-google?action=callback (dev)
#   https://<votre-site>.netlify.app/api/auth-google?action=callback (prod)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URL publique de l'appli (utilisée pour construire l'URL de redirection OAuth)
# ex: https://mon-app.netlify.app
APP_BASE_URL=http://localhost:8888

# --- Session ---
# Clé secrète utilisée pour chiffrer le cookie de session.
# Générer avec: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Base de données (Netlify DB / Neon : contrats, jours déclarés, jours fériés entreprise) ---
# Provisionnée depuis Netlify (onglet Database du site, ou `netlify db init`) :
# la variable est alors injectée automatiquement, en prod comme en local via
# `netlify dev`. Renseigner NETLIFY_DATABASE_URL ici seulement si vous testez
# avec une chaîne de connexion Neon obtenue autrement. Voir db/migrations/
# pour le schéma à exécuter.
NETLIFY_DATABASE_URL=
