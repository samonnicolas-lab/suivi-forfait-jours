# Copier en .env (jamais commité) et renseigner les vraies valeurs.

# --- Serveur ---
PORT=4000

# --- Authentification (service partagé auth-maison) ---
# Utilisé côté serveur pour vérifier la session (appel à /me en transmettant
# le cookie reçu du navigateur) — pas d'auth Google ni de session maison ici.
AUTH_MAISON_URL=https://auth.carlezia.fr
# Utilisé côté navigateur (Vite inline cette valeur au moment du build) pour
# appeler directement auth-maison depuis le frontend (login/register/logout).
VITE_AUTH_URL=https://auth.carlezia.fr

# --- Base de données ---
# En Docker Compose, "db" est le nom du service Postgres (résolu par le réseau Docker interne).
DATABASE_URL=postgresql://forfait_jours:CHANGE_ME@db:5432/forfait_jours
# Identifiants utilisés par le conteneur Postgres lui-même (docker-compose.yml)
POSTGRES_USER=forfait_jours
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=forfait_jours
